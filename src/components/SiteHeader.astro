---
import { conference } from '../data/conference';
import { href } from '../lib/url';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const primary = [
  ['Call for papers', '/call-for-papers/'],
  ['Review', '/review/'],
  ['Dates', '/dates/'],
  ['Attend', '/attend/'],
  ['FAQ', '/faq/'],
] as const;
const cta = ['Get involved', '/get-involved/'] as const;
const normalize = (path: string) => path.replace(/\/?$/, '/');
const active = (path: string) => normalize(currentPath).startsWith(href(path));
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={href('/')} aria-label={`${conference.name} home`}>
      <img src={href('/brand/roar-compact-dark.svg')} alt="" width="141" height="36" />
      <span class="brand-year">{conference.year}</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {primary.map(([label, path]) => (
        <a href={href(path)} aria-current={active(path) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="icon-link" href={conference.repo} aria-label="ROAR on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <a class="laion-link" href={conference.laion}>
        by LAION <span aria-hidden="true">↗</span>
      </a>
      <a
        class="button accent header-cta"
        href={href(cta[1])}
        aria-current={active(cta[1]) ? 'page' : undefined}
      >
        {cta[0]}
      </a>
      <details class="mobile-nav">
        <summary aria-label="Navigation menu">
          <span class="menu-icon" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
        </summary>
        <nav aria-label="Mobile navigation">
          <div class="mobile-primary">
            {[['Home', '/'] as const, ...primary, cta].map(([label, path]) => (
              <a
                href={href(path)}
                aria-current={
                  (path === '/' ? normalize(currentPath) === href('/') : active(path))
                    ? 'page'
                    : undefined
                }
              >
                {label}
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <div class="socials">
            <a href={`mailto:${conference.contact}`}>Email</a>
            <a href={conference.discord}>Discord</a>
            <a href={conference.repo}>GitHub</a>
            <a href={conference.laion}>LAION</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line-dark);
    background: rgba(6, 18, 32, 0.95);
    color: var(--on-dark);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    backdrop-filter: saturate(160%) blur(18px);
  }
  .header-inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    min-height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-right: auto;
    color: white;
    line-height: 1;
    text-decoration: none;
  }
  .brand img {
    display: block;
    width: auto;
    height: 2.25rem;
    transition: opacity 0.2s ease;
  }
  .brand:hover img {
    opacity: 0.85;
  }
  .brand-year {
    padding: 0.22rem 0.45rem;
    border: 1px solid rgba(245, 200, 76, 0.4);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }
  .desktop-nav {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.98rem;
  }
  .desktop-nav > a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--on-dark-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .desktop-nav > a:hover {
    background: rgba(255, 255, 255, 0.07);
    color: white;
  }
  .desktop-nav > a[aria-current='page'] {
    color: white;
    background: rgba(255, 255, 255, 0.09);
  }
  .header-actions {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .icon-link {
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 999px;
    color: var(--on-dark-muted);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .icon-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }
  .laion-link {
    padding: 0.45rem 0.6rem;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .laion-link:hover {
    color: var(--accent);
  }
  .header-cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.95rem;
  }
  .mobile-nav {
    display: none;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  @media (max-width: 1080px) {
    .laion-link {
      display: none;
    }
  }
  @media (max-width: 940px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav > summary {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border: 1px solid var(--line-dark);
      border-radius: 999px;
      list-style: none;
      cursor: pointer;
    }
    .menu-icon {
      display: grid;
      gap: 0.32rem;
    }
    .mobile-nav > summary i {
      display: block;
      width: 1.1rem;
      height: 1.5px;
      background: white;
      transition: transform 0.2s var(--ease-out);
    }
    .mobile-nav[open] > summary i:first-child {
      transform: translateY(0.2rem) rotate(45deg);
    }
    .mobile-nav[open] > summary i:last-child {
      transform: translateY(-0.2rem) rotate(-45deg);
    }
    .mobile-nav nav {
      position: fixed;
      inset: var(--header-height) 0 auto;
      display: grid;
      gap: 1.5rem;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: 1rem max(1rem, calc((100vw - 80rem) / 2)) 2rem;
      border-bottom: 1px solid var(--line-dark);
      background: var(--night);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
    }
    .mobile-primary {
      display: grid;
    }
    .mobile-primary a {
      display: flex;
      justify-content: space-between;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line-dark);
      color: white;
      font-size: 1.6rem;
      font-weight: 900;
      text-decoration: none;
    }
    .mobile-primary a span {
      color: var(--on-dark-muted);
      font-weight: 400;
    }
    .mobile-primary a[aria-current='page'] {
      color: var(--accent);
    }
    .socials {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .socials a {
      color: var(--on-dark-muted);
      text-decoration: none;
    }
  }
  @media (max-width: 520px) {
    .icon-link {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .header-cta {
      display: none;
    }
  }
</style>
