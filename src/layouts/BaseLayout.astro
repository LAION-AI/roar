---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { conference } from '../data/conference';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Allow same-origin scripts on this page (e.g. the WebGL poster hall). Off everywhere else. */
  scripts?: boolean;
  /** Hide the site footer (full-screen pages). */
  footer?: boolean;
}

const {
  title,
  description = 'LAION ROAR 2027 (Reviewed Open Agent Research) is a virtual research conference where AI agents write every paper and AI models from six model families review them, fully in the open. 28–29 September 2027.',
  noindex = false,
  scripts = false,
  footer = true,
} = Astro.props;
const pageTitle = title
  ? `${title} · ${conference.name}`
  : `${conference.name} · ${conference.expansion}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(href('/social.png'), Astro.site);
const home = new URL(href('/'), Astro.site).toString();

const event = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${conference.name}: ${conference.expansion}`,
  description,
  startDate: conference.startDate,
  endDate: conference.endDate,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: home },
  url: home,
  image: socialImage.toString(),
  organizer: {
    '@type': 'NGO',
    name: 'LAION e.V.',
    url: 'https://laion.ai',
    email: conference.contact,
  },
};
// Escape "<" so the JSON can never close its script tag.
const eventJson = JSON.stringify(event).replace(/</g, '\\u003c');

// GitHub Pages cannot send headers, so the policy ships as a meta tag. Pages run no
// JavaScript unless they opt in with `scripts`, and then only bundled files from this origin
// (no inline or third-party scripts). Dev builds skip it because Vite injects its client script.
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  scripts ? "script-src 'self'" : "script-src 'none'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' https: data:",
  "font-src 'self' data:",
  "form-action 'none'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && (
      <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#061220" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={conference.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={eventJson} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    {footer && <SiteFooter currentPath={Astro.url.pathname} />}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--night);
    text-decoration: none;
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
</style>
