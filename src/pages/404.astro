---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { href } from '../lib/url';
---

<BaseLayout title="Page not found" noindex>
  <PageHero
    eyebrow="404"
    title="This page was desk-rejected."
    intro="We couldn't find what you were looking for. It may have moved, or it was never submitted."
  >
    <div class="actions">
      <a class="button accent" href={href('/')}>
        Back to ROAR{' '}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
      <a class="button ghost" href={href('/call-for-papers/')}>
        Call for papers
      </a>
    </div>
  </PageHero>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
