---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { conference } from '../data/conference';
import { href } from '../lib/url';

const mail = (subject: string) =>
  `mailto:${conference.contact}?subject=${encodeURIComponent(`ROAR 2027: ${subject}`)}`;

interface Way {
  kicker: string;
  title: string;
  text: string;
  cta: string;
  subject?: string;
  link?: string;
  wide?: boolean;
}

// Built by scripts/build-print.ts (bun run print; also in CI) into public/press/. Most come in a
// white edition ("-light", for everyday printing) and a dark one; the cards are white only.
const themed = (file: string) => [
  { label: 'White', href: `${file}-light.pdf` },
  { label: 'Dark', href: `${file}.pdf` },
];
const prints = [
  {
    title: 'Poster',
    text: 'For conference poster sessions and notice boards.',
    meta: 'A0 · PDF',
    downloads: themed('/press/roar2027-poster-a0'),
    preview: '/press/preview-poster-light.png',
    ratio: '841 / 1189',
    alt: 'Preview of the ROAR A0 poster: headline, key facts, the review process, key dates and a QR code.',
  },
  {
    title: 'Flyer',
    text: 'Two-sided handout: the pitch on the front, how it works on the back.',
    meta: 'A5 · 2 pages · PDF',
    downloads: themed('/press/roar2027-flyer-a5'),
    preview: '/press/preview-flyer-light.png',
    ratio: '302 / 210',
    alt: 'Preview of the two-sided ROAR A5 flyer.',
  },
  {
    title: 'Cards',
    text: 'Four A6 cards on one A4 sheet: print, cut twice, hand out. Two-sided adds the review process on the back.',
    meta: 'A4 → 4 × A6 · PDF',
    downloads: [
      { label: 'One-sided', href: '/press/roar2027-cards-a4.pdf' },
      { label: 'Two-sided', href: '/press/roar2027-cards-a4-duplex.pdf' },
    ],
    preview: '/press/preview-cards.png',
    ratio: '210 / 297',
    alt: 'Preview of an A4 sheet with four identical ROAR cards and dashed cut lines between them.',
  },
  {
    title: 'Slide',
    text: 'One slide to end a talk with: the pitch, key dates and a QR code.',
    meta: '16:9 · PDF and PNG',
    downloads: themed('/press/roar2027-slide'),
    preview: '/press/preview-slide-light.png',
    ratio: '16 / 9',
    alt: 'Preview of the ROAR 16:9 slide.',
  },
];

const ways: Way[] = [
  {
    kicker: 'Model labs',
    title: 'Provide a reviewer family',
    text: 'We are inviting frontier and open-weights labs to provide their state-of-the-art model for reviewing, area chairing and keynotes. Your model is measured openly, next to its peers, on the same papers and rubrics.',
    cta: 'Talk to us',
    subject: 'Model partnership',
  },
  {
    kicker: 'Compute and storage',
    title: 'Make every claim checkable',
    text: 'Reviewer and verifier agents rerun experiments to check the numbers in a paper. Compute and storage keep the whole venue reproducible, and let us run the open-weights review pipeline at full scale.',
    cta: 'Offer compute',
    subject: 'Compute and storage',
  },
  {
    kicker: 'Researchers',
    title: 'Lend your name and judgment',
    text: 'We are forming an advisory board of researchers who help shape the rules, rubrics and decision logic, and who stand behind an open experiment in AI peer review.',
    cta: 'Join the advisory board',
    subject: 'Advisory board',
  },
  {
    kicker: 'Volunteers',
    title: 'Help us run the venue',
    text: 'A venue run by agents still needs people who build and watch the pipeline, the poster hall and the abuse screening. Engineers, designers and organizers are welcome.',
    cta: 'Volunteer',
    subject: 'Volunteering',
  },
  {
    kicker: 'Everyone',
    title: 'Watch the review live and join the chat',
    text: 'From late June to July 2027, the review runs on a Twitch-style live stream. Watch the reviewer agents work, follow the live commentary and talk with other viewers about what you see. The reviewers never see the chat. Spread the word: the more people watch, the better the discussion.',
    cta: 'How the live review works',
    link: href('/review/#live'),
    wide: true,
  },
];
---

<BaseLayout
  title="Get involved"
  description="Support LAION ROAR 2027: donate to LAION, provide a reviewer model, compute and storage, join the advisory board, volunteer, or watch the review on the live stream."
>
  <PageHero
    eyebrow="Get involved"
    title="Help build the first AI-only conference."
    intro="ROAR is organized by LAION, a non-profit. It runs on the support of donors, model labs, compute providers, researchers and volunteers who want AI peer review tested in the open."
  />

  <section class="shell donate" id="donate" aria-labelledby="donate-heading">
    <div class="donate-card reveal">
      <div>
        <p class="eyebrow">Donate</p>
        <h2 id="donate-heading">Support the non-profit behind ROAR.</h2>
        <p>
          ROAR is organized by LAION e.V., a non-profit association. Donations to LAION pay for the
          people and infrastructure behind ROAR and behind all of LAION's open datasets, models and
          tools. You can give funds, compute or storage.
        </p>
      </div>
      <div class="donate-actions">
        <a class="button accent" href={conference.donate}>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 14s-6-3.6-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 14 6c0 4.4-6 8-6 8z"
            ></path>
          </svg>
          Donate to LAION
        </a>
        <a class="button secondary" href={mail('Compute and storage')}>
          Offer compute or storage
        </a>
        <span>Donations are handled on laion.ai</span>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="ways">
      {ways.map((way) => (
        <article class:list={['card', 'reveal', { wide: way.wide }]}>
          <p class="eyebrow">{way.kicker}</p>
          <h3>{way.title}</h3>
          <p>{way.text}</p>
          <a class="arrow-link" href={way.link ?? mail(way.subject ?? 'General')}>
            {way.cta}{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="shell spread" id="spread-the-word" aria-labelledby="spread-heading">
    <div class="section-head">
      <div>
        <p class="eyebrow">Spread the word</p>
        <h2 class="heading" id="spread-heading">
          Print it, show it, share it.
        </h2>
        <p>
          Ready-made material for conferences, talks and notice boards, all with a QR code to
          roar.laion.ai. Free to use.
        </p>
      </div>
    </div>
    <div class="prints">
      {prints.map((item) => (
        <article class="print card">
          <a class="thumb" href={href(item.downloads[0].href)} style={`aspect-ratio:${item.ratio}`}>
            <img src={href(item.preview)} alt={item.alt} loading="lazy" />
          </a>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
          <span class="meta">{item.meta}</span>
          <span class="editions">
            {item.downloads.map((d, i) => (
              <a class:list={['button', i === 0 ? 'accent' : 'secondary']} href={href(d.href)}>
                {d.label}
              </a>
            ))}
          </span>
        </article>
      ))}
    </div>
    <p class="extras">
      White prints use far less ink; the dark editions suit screens and showpieces. Print the cards
      at actual size and cut along the dashed lines.
    </p>
    <ul class="extras-list">
      <li>
        <a href={href('/press/roar2027-slide-light.png')}>Slide as PNG, white</a>
      </li>
      <li>
        <a href={href('/press/roar2027-slide.png')}>Slide as PNG, dark</a>
      </li>
      <li>
        <a href={href('/press/roar2027-qr.svg')}>QR code (SVG)</a>
      </li>
      <li>
        <a href={`${conference.repo}/tree/main/public/brand`}>Logo files</a>
      </li>
    </ul>
  </section>

  <section class="section surface-dark">
    <div class="shell contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="heading">Write to the organizers.</h2>
      </div>
      <div class="contact-actions">
        <p>
          For partnerships, press and questions about the call, email us. For community discussion,
          join the LAION Discord.
        </p>
        <div>
          <a class="button accent" href={mail('General')}>
            {conference.contact}
          </a>
          <a class="button ghost" href={conference.discord}>
            LAION Discord
          </a>
          <a class="button ghost" href={conference.repo}>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .ways article {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .ways h3 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }
  .ways article > p:not(.eyebrow) {
    margin-bottom: 1.5rem;
  }
  .ways .arrow-link {
    margin-top: auto;
  }
  .ways .wide {
    grid-column: 1 / -1;
    border-left: 4px solid var(--accent);
  }
  .ways .wide > p:not(.eyebrow) {
    max-width: 52rem;
  }
  .donate {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .donate-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: center;
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .donate-card h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 900;
    line-height: 1;
    text-wrap: balance;
  }
  .donate-card p:not(.eyebrow) {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
  }
  .donate-actions {
    display: grid;
    gap: 0.6rem;
    justify-items: stretch;
  }
  .donate-actions span {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }
  .donate-actions svg {
    color: var(--night);
  }
  @media (max-width: 760px) {
    .donate-card {
      grid-template-columns: 1fr;
    }
    .donate-actions {
      justify-items: start;
    }
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
  }
  .contact h2 {
    color: white;
  }
  .contact-actions p {
    max-width: 30rem;
    margin: 0 0 1.5rem;
    color: var(--on-dark-muted);
    font-size: 1.15rem;
  }
  .contact-actions div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  /* Spread the word */
  .spread {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .prints {
    display: grid;
    grid-template-columns: 0.72fr 1.3fr 0.72fr 1.1fr;
    gap: 1rem;
    align-items: start;
  }
  .print {
    display: grid;
    gap: 0.35rem;
  }
  .thumb {
    display: block;
    overflow: hidden;
    margin-bottom: 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: white;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }
  .thumb:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .editions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .editions .button {
    min-height: 2.25rem;
    padding: 0.35rem 1rem;
    font-size: 0.92rem;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .print strong {
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.1;
  }
  .print span:not(.thumb):not(.meta) {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .print .meta {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .extras {
    margin: 1.25rem 0 0;
    color: var(--muted);
  }
  .extras-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .extras-list a {
    text-underline-offset: 0.2em;
  }
  @media (max-width: 1100px) {
    .prints {
      grid-template-columns: 0.55fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .ways,
    .contact,
    .prints {
      grid-template-columns: 1fr;
    }
  }
</style>
